{
  "name": "@openhilo/ai-codex",
  "version": "0.1.0",
  "private": true,
  "description": "Codex CLI app-server implementation of the AI task contract",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./studio": {
      "types": "./studio/index.tsx",
      "import": "./studio/index.tsx",
      "default": "./studio/index.tsx"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.txt",
    "studio"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@openhilo/ai-contracts": "0.1.0",
    "@openhilo/studio-contracts": "0.1.0"
  },
  "typesVersions": {
    "*": {
      "studio": [
        "studio/index.tsx"
      ]
    }
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenHilo/OpenHilo.git",
    "directory": "adapters/ai-codex"
  },
  "homepage": "https://github.com/OpenHilo/OpenHilo/tree/main/adapters/ai-codex#readme",
  "bugs": {
    "url": "https://github.com/OpenHilo/OpenHilo/issues"
  }
}
