{
  "name": "@openhilo/ai-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral task execution contracts for OpenHilo",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "require": "./dist/routing.js",
      "default": "./dist/routing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "jest --config jest.config.cjs --runInBand"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenHilo/OpenHilo.git",
    "directory": "packages/ai-contracts"
  },
  "homepage": "https://github.com/OpenHilo/OpenHilo/tree/main/packages/ai-contracts#readme",
  "bugs": {
    "url": "https://github.com/OpenHilo/OpenHilo/issues"
  },
  "typesVersions": {
    "*": {
      "routing": [
        "dist/routing.d.ts"
      ]
    }
  },
  "dependencies": {
    "@openhilo/itt-contracts": "0.1.0"
  }
}
