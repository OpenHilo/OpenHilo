{
  "name": "@openhilo/runtime-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime extension policies and serializable frame context",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@openhilo/ai-contracts": "0.1.0",
    "@openhilo/itt-contracts": "0.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenHilo/OpenHilo.git",
    "directory": "packages/runtime-contracts"
  },
  "homepage": "https://github.com/OpenHilo/OpenHilo/tree/main/packages/runtime-contracts#readme",
  "bugs": {
    "url": "https://github.com/OpenHilo/OpenHilo/issues"
  }
}
